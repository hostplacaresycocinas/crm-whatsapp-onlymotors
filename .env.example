# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo servidor. La usa el webhook para escribir sin sesión de usuario.
SUPABASE_SECRET_KEY=sb_secret_...

# Meta — Facebook App (1688295142815246), Configuración → Básica → Clave secreta
# Se usa para verificar la firma X-Hub-Signature-256 del webhook.
META_APP_SECRET=

# Texto libre que inventás vos. Se pega igual en Meta → WhatsApp → Configuración → Webhook.
WHATSAPP_VERIFY_TOKEN=
